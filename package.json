{
    "name": "@johannes.latzel/llm-chat-drawio",
    "version": "0.1.0",
    "description": "Headless draw.io diagram rendering tools for the llm-chat package",
    "license": "MIT",
    "sideEffects": false,
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "author": "Johannes B. Latzel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johanneslatzel/llm-chat-drawio.git"
    },
    "bugs": {
        "url": "https://github.com/johanneslatzel/llm-chat-drawio/issues"
    },
    "homepage": "https://github.com/johanneslatzel/llm-chat-drawio#readme",
    "keywords": [
        "llm",
        "chat",
        "drawio",
        "diagram",
        "svg",
        "png",
        "tool"
    ],
    "engines": {
        "node": ">=22"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prebuild": "rm -rf dist/",
        "prepack": "npm run build",
        "build": "tsc -p tsconfig.build.json",
        "check:mkdocs": "check-mkdocs",
        "check:lines": "check-line-limits",
        "verify": "tsc --noEmit && eslint . --max-warnings 0 && npm run check:lines && npm run check:mkdocs && vitest run --coverage",
        "audit": "npm audit --audit-level=high",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write 'docs/**/*.md' 'src/**/*.ts' 'tests/**/*.ts'",
        "docs": "docker run --rm -it -p 8000:8000 -v $PWD:/docs squidfunk/mkdocs-material",
        "test": "vitest",
        "test:unit": "vitest run",
        "test:coverage": "vitest run --coverage",
        "clean:pack": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify && npm run build && npm pack",
        "clean:install": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify",
        "prepare": "husky"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "prettier --write",
            "eslint --max-warnings 0 --no-warn-ignored",
            "vitest related --run"
        ]
    },
    "dependencies": {
        "@johannes.latzel/llm-chat": "^0.8.0",
        "@johannes.latzel/llm-chat-workspace": "^0.2.0",
        "@maxgraph/core": "^0.25.0",
        "@resvg/resvg-js": "^2.6.2",
        "global-jsdom": "^30.0.0",
        "jsdom": "^30.1.3",
        "pako": "^3.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@johannes.latzel/check-line-limits": "^1.0.1",
        "@johannes.latzel/check-mkdocs": "^0.1.0",
        "@types/node": "^26.2.0",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-n": "^18.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.5.3",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0"
    }
}
